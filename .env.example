# Copia este archivo como .env (NO lo subas a GitHub) y llena los valores.
# En producción se configuran en Netlify: Site configuration > Environment variables
# (alcance: All deploys y Functions) y después Trigger deploy.

# SMTP de Gmail con contraseña de aplicación (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yolcatl.firecat@gmail.com
SMTP_PASS=
EMAIL_FROM="Yolcatl" <yolcatl.firecat@gmail.com>

# Dónde llegan los mensajes del formulario de contacto
CONTACT_TO=yolcatl.firecat@gmail.com

# Secreto para POST /api/send-email (header x-api-key). Genera uno largo y aleatorio.
API_SECRET_KEY=

# Opcional: "false" para no enviar correo de bienvenida al suscribirse
WELCOME_EMAIL=true
